
# ─── API ─────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:8080/api

# Socket.IO server for the volunteer matching gateway.
# Leave empty to use the app's own origin (prod: front + socket on one domain).

VITE_SOCKET_URL=

# Request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT=15000

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_TITLE=My App
VITE_APP_ENV=development

# ─── DevTools ────────────────────────────────────────────────────────────────
# Set to "true" to show TanStack Query DevTools and Zustand devtools.

VITE_ENABLE_DEVTOOLS=true


